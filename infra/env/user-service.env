USER_DB_USER=user_service
USER_DB_PASSWORD=user_password
USER_DB_NAME=user_service

# Service Configuration
DATABASE_URL=postgresql://user_service:user_password@user-db:5432/user_service?schema=public

# Redis & RabbitMQ shared
REDIS_URL=redis://:@redis:6379
RABBITMQ_URL=amqp://admin:password@rabbitmq:5672

# Service-specific settings
JWT_SECRET=user-service-specific-secret
EMAIL_TEMPLATES_PATH=/app/templates/email
UPLOAD_PATH=/app/uploads

# ===== infra/env/course-service.env =====
# Course Service Database  
COURSE_DB_USER=course_service
COURSE_DB_PASSWORD=course_secure_password
COURSE_DB_NAME=course_service

# Service Configuration
DATABASE_URL=postgresql://course_service:course_secure_password@course-db:5432/course_service?schema=public

# Shared services
REDIS_URL=redis://:@redis:6379
RABBITMQ_URL=amqp://admin:password@rabbitmq:5672

# External services
AWS_S3_BUCKET=mini-udemy-courses
STRIPE_WEBHOOK_ENDPOINT=/webhooks/stripe
