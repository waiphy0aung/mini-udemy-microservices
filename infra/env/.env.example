NODE_ENV=development
LOG_LEVEL=info

# Service Ports (Host mapping)
GATEWAY_PORT=3000
USER_SERVICE_PORT=3001

# Database (Host mapping)
POSTGRES_HOST_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mini_udemy

# Redis (Host mapping)
REDIS_HOST_PORT=6380
REDIS_PASSWORD=

# RabbitMQ (Host mapping)
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=password
RABBITMQ_VHOST=mini_udemy

# Development Tools (Host mapping)
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
ADMINER_PORT=8080

# Monitoring (Host mapping)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Security (CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-change-in-production

# CORS
CORS_ORIGIN=http://localhost:8000,http://localhost:3000

# External Services (Optional for development)
SENDGRID_API_KEY=your_sendgrid_api_key
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=mini-udemy-uploads
